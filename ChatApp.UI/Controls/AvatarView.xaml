<UserControl x:Class="ChatApp.UI.Controls.AvatarView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:ChatApp.UI.Converters"
             x:Name="Root"
             ClipToBounds="True">
    <UserControl.Resources>
        <conv:AvatarToBitmapConverter x:Key="AvatarImage"/>
        <conv:AvatarToTextConverter x:Key="AvatarText"/>
    </UserControl.Resources>
    <Grid>
        <Image Source="{Binding Avatar, ElementName=Root, Converter={StaticResource AvatarImage}}"
               Stretch="UniformToFill"/>
        <TextBlock Text="{Binding Avatar, ElementName=Root, Converter={StaticResource AvatarText}}"
                   FontSize="{Binding FontSize, ElementName=Root}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>

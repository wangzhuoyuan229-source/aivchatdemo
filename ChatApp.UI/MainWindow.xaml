<Window x:Class="ChatApp.UI.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:ChatApp.UI.Converters"
        Title="{Binding WindowTitle}" Height="820" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Icon="/Assets/icon.png">
  <Window.Resources>
    <conv:NullToVisibilityConverter x:Key="Null2Vis"/>
    <conv:InverseNullToVisibilityConverter x:Key="InverseNull2Vis"/>
    <conv:StringEqualsConverter x:Key="StringEquals"/>
    <conv:BooleanToVisibilityInverseConverter x:Key="Bool2VisInv"/>
    <conv:AvatarToBitmapConverter x:Key="SocialIconImage"/>
  </Window.Resources>
  <Grid>
    <Grid ColumnDefinitions="76,Auto,*">
      <Border Grid.Column="0" Background="{DynamicResource NavRailBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Grid.Row="0" Width="48" Height="48" CornerRadius="12" Background="Transparent"
                  HorizontalAlignment="Center" Margin="0,18,0,16" ClipToBounds="True">
            <Image Source="/Assets/Icons/app-logo.png" Stretch="Uniform"/>
          </Border>
          <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Button Classes="nav" ToolTip.Tip="角色库" Command="{Binding ShowRolesCommand}">
              <Grid Width="44" Height="44">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12"
                        IsVisible="{Binding CurrentPageKey, Converter={StaticResource StringEquals}, ConverterParameter=roles}"/>
                <Border Width="24" Height="24" Background="{DynamicResource NavIconBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border.OpacityMask>
                    <ImageBrush Source="/Assets/Icons/nav-roles.png" Stretch="Uniform"/>
                  </Border.OpacityMask>
                </Border>
              </Grid>
            </Button>
            <Button Classes="nav" ToolTip.Tip="知识库" Command="{Binding ShowKnowledgeCommand}">
              <Grid Width="44" Height="44">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12"
                        IsVisible="{Binding CurrentPageKey, Converter={StaticResource StringEquals}, ConverterParameter=knowledge}"/>
                <Border Width="24" Height="24" Background="{DynamicResource NavIconBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border.OpacityMask>
                    <ImageBrush Source="/Assets/Icons/nav-knowledge.png" Stretch="Uniform"/>
                  </Border.OpacityMask>
                </Border>
              </Grid>
            </Button>
            <Button Classes="nav" ToolTip.Tip="设置" Command="{Binding ShowSettingsCommand}">
              <Grid Width="44" Height="44">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="12"
                        IsVisible="{Binding CurrentPageKey, Converter={StaticResource StringEquals}, ConverterParameter=settings}"/>
                <Border Width="24" Height="24" Background="{DynamicResource NavIconBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border.OpacityMask>
                    <ImageBrush Source="/Assets/Icons/nav-settings.png" Stretch="Uniform"/>
                  </Border.OpacityMask>
                </Border>
              </Grid>
            </Button>
            <Button Classes="nav" ToolTip.Tip="帮助与支持" Command="{Binding ShowDeveloperHelpCommand}">
              <Border Width="24" Height="24" Background="{DynamicResource NavIconBrush}">
                <Border.OpacityMask>
                  <ImageBrush Source="/Assets/Icons/nav-help.png" Stretch="Uniform"/>
                </Border.OpacityMask>
              </Border>
            </Button>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="v1.3.7" Foreground="{DynamicResource TimeBrush}" FontSize="10"
                     HorizontalAlignment="Center" Margin="0,0,0,12"/>
        </Grid>
      </Border>

      <Border Grid.Column="1" Width="350" Background="{DynamicResource ListPaneBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0"
              IsVisible="{Binding MiddleView, Converter={StaticResource Null2Vis}}">
        <ContentControl Content="{Binding MiddleView}"/>
      </Border>

      <Grid Grid.Column="2">
        <ContentControl Content="{Binding RightView}"/>
        <Border IsVisible="{Binding RightView, Converter={StaticResource InverseNull2Vis}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="76" Height="76" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
              <TextBlock Text="AI" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="选择一个角色，开始聊天" FontSize="14" Foreground="{DynamicResource TextSubBrush}" Margin="0,18,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Grid IsVisible="{Binding IsDeveloperHelpOpen}" Background="#66000000" Panel.ZIndex="10">
      <Border Classes="floating" Padding="24" Width="440" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="开发者社交账户" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding DeveloperSocialItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,6" ColumnDefinitions="Auto,*,Auto,Auto">
                  <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" ClipToBounds="True"
                          VerticalAlignment="Center" Margin="0,0,12,0" Background="{DynamicResource SubtleBrush}">
                    <Grid>
                      <TextBlock Text="{Binding Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding HasIconAsset, Converter={StaticResource Bool2VisInv}}"/>
                      <Image Source="{Binding IconAsset, Converter={StaticResource SocialIconImage}}" Stretch="UniformToFill"
                             IsVisible="{Binding HasIconAsset}"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium"/>
                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="打开" Command="{Binding $parent[Window].DataContext.OpenDeveloperSocialCommand}" CommandParameter="{Binding}" Margin="8,0,4,0" Padding="8,2"/>
                  <Button Grid.Column="3" Content="复制" Command="{Binding $parent[Window].DataContext.CopyDeveloperSocialCommand}" CommandParameter="{Binding CopyText}" IsVisible="{Binding CopyText, Converter={StaticResource Null2Vis}}" Padding="8,2"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="B站 UID:451598529 · 小红书 7439240082 · 邮箱 1037561013@qq.com · 欢迎私信" FontSize="11" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.9"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Command="{Binding CloseDeveloperHelpCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>

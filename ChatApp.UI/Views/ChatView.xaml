<UserControl x:Class="ChatApp.UI.Views.ChatView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChatApp.UI.ViewModels"
             xmlns:conv="using:ChatApp.UI.Converters"
             xmlns:controls="using:ChatApp.UI.Controls"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:BoolToAlignmentConverter x:Key="Align"/>
        <conv:BoolToFlowDirectionConverter x:Key="FlowDir"/>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:BooleanToVisibilityInverseConverter x:Key="Bool2VisInv"/>
        <conv:BubbleBrushConverter x:Key="BubbleBrush"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1" Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                        Background="#E5F5EB" Margin="0,0,10,0" ClipToBounds="True">
                    <controls:AvatarView Avatar="{Binding ConversationAvatar}" FontSize="21"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Text="{Binding ConversationSubtitle}" FontSize="11"
                               Foreground="{StaticResource TextSubBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#F1F8F3" CornerRadius="10" Padding="9,4"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSending, Converter={StaticResource Bool2Vis}}">
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentDarkBrush}"
                               FontSize="11"/>
                </Border>
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
            <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6" HorizontalAlignment="{Binding IsUser, Converter={StaticResource Align}}"
                              FlowDirection="{Binding IsUser, Converter={StaticResource FlowDir}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="#F2F2F2" VerticalAlignment="Top" Margin="0,0,8,0" ClipToBounds="True">
                                <controls:AvatarView Avatar="{Binding Avatar}" FontSize="22"/>
                            </Border>
                            <Border Grid.Column="1" MaxWidth="520" CornerRadius="8" Padding="12,8" VerticalAlignment="Top"
                                    Background="{Binding IsUser, Converter={StaticResource BubbleBrush}}">
                                <StackPanel FlowDirection="LeftToRight">
                                    <TextBlock Text="{Binding RoleName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               Margin="0,0,0,4" HorizontalAlignment="Left"
                                               IsVisible="{Binding IsGroupBubble, Converter={StaticResource Bool2Vis}}"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#B0B0B0" Margin="0,0,0,4"
                                               HorizontalAlignment="{Binding IsUser, Converter={StaticResource Align}}"/>
                                    <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding OpenCommand}" Padding="0" Margin="0,0,8,8"
                                                        ToolTip.Tip="{Binding Caption}">
                                                    <Grid Width="180" Height="130">
                                                        <Border Background="#ECECEC" CornerRadius="5"/>
                                                        <Image Source="{Binding Preview}"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding IsAvailable, Converter={StaticResource Bool2Vis}}"/>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsAvailable, Converter={StaticResource Bool2VisInv}}">
                                                            <TextBlock Text="🖼️" FontSize="24" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="图片缺失或损坏" FontSize="10" Foreground="{StaticResource TextSubBrush}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InputBox" Text="{Binding InputText}"
                         AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MaxHeight="120" MinHeight="40" FontSize="14" Padding="10,8"
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1" Classes="ghost" Content="停止"
                        Command="{Binding StopCommand}" Margin="6,0,0,0"
                        IsVisible="{Binding IsSending, Converter={StaticResource Bool2Vis}}"/>
                <Button Grid.Column="2" Classes="primary" Content="发送"
                        Command="{Binding SendCommand}" Margin="6,0,0,0" Padding="22,10"
                        FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

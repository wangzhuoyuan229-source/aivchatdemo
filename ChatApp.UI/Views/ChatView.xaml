<UserControl x:Class="ChatApp.UI.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChatApp.UI.ViewModels"
             xmlns:conv="clr-namespace:ChatApp.UI.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:BoolToAlignmentConverter x:Key="Align"/>
        <conv:BoolToFlowDirectionConverter x:Key="FlowDir"/>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:BooleanToVisibilityInverseConverter x:Key="Bool2VisInv"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource TextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Messages -->
        <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgBrush}">
            <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChatBubbleViewModel}">
                        <Grid Margin="0,6" HorizontalAlignment="{Binding IsUser, Converter={StaticResource Align}}"
                              FlowDirection="{Binding IsUser, Converter={StaticResource FlowDir}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6" Background="#F2F2F2" VerticalAlignment="Top" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Avatar}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1" MaxWidth="520" CornerRadius="8" Padding="12,8" VerticalAlignment="Top"
                                    Background="{Binding IsUser, Converter={x:Static conv:BubbleBrushConverter.Instance}}">
                                <StackPanel FlowDirection="LeftToRight">
                                    <TextBlock Text="{Binding RoleName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               Margin="0,0,0,4" HorizontalAlignment="Left"
                                               Visibility="{Binding IsGroupBubble, Converter={StaticResource Bool2Vis}}"/>
                                    <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#B0B0B0" Margin="0,0,0,4"
                                               HorizontalAlignment="{Binding IsUser, Converter={StaticResource Align}}"/>
                                    <TextBlock Text="{Binding Content}" FontSize="14" TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Input -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         MaxHeight="120" MinHeight="40" FontSize="14" Padding="10,8"
                         KeyDown="InputBox_KeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="停止"
                        Command="{Binding StopCommand}" Margin="6,0,0,0"
                        Visibility="{Binding IsSending, Converter={StaticResource Bool2Vis}}"/>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="发送"
                        Command="{Binding SendCommand}" Margin="6,0,0,0" Padding="22,10"
                        FontSize="14"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

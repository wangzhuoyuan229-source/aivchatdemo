<Window x:Class="ChatApp.UI.Views.CreateRoleWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:ChatApp.UI.Converters"
        xmlns:controls="using:ChatApp.UI.Controls"
        Title="{Binding WindowTitle}" Height="680" Width="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:BooleanToVisibilityInverseConverter x:Key="Bool2VisInv"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,18">
            <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <StackPanel>
                <!-- 1. 头像 -->
                <Grid Margin="0,0,0,12" RowDefinitions="Auto,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="头像" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="8" Background="{DynamicResource SubtleBrush}"
                                ClipToBounds="True" Margin="0,0,10,0">
                            <controls:AvatarView Avatar="{Binding Avatar}" FontSize="27"/>
                        </Border>
                        <TextBox Text="{Binding Avatar}" MaxLength="8" Width="72" VerticalAlignment="Center"
                                 IsVisible="{Binding HasImageAvatar, Converter={StaticResource Bool2VisInv}}"
                                 Watermark="emoji"/>
                        <Button Classes="ghost" Content="从知识库匹配" Command="{Binding MatchAvatarCommand}"
                                IsEnabled="{Binding !IsSaving}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Classes="ghost" Content="改用 emoji" Command="{Binding UseEmojiAvatarCommand}"
                                IsVisible="{Binding HasImageAvatar, Converter={StaticResource Bool2Vis}}"
                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvatarMatchStatus}" FontSize="10"
                               Foreground="{StaticResource AccentDarkBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
                <!-- 2. 名称 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名称 *" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Name}" Watermark="例如：林溪"/>
                </Grid>
                <!-- 3. 用户扮演角色 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="你扮演谁" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding UserPersona}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                 Watermark="例如：博士；或：你是罗德岛的博士，与凯尔希长期并肩工作。"/>
                        <TextBlock Text="告诉角色如何称呼你、你们是什么关系；留空时按普通用户处理。"
                                   FontSize="10" Foreground="{DynamicResource TextSubBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <!-- 4. 知识分组 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="知识分组" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1">
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="70" MaxHeight="140" Background="{DynamicResource PanelBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding KnowledgeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{Binding KnowledgeBindingHint}" FontSize="10" Foreground="{DynamicResource WarnBrush}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <!-- 5. 补充设定 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="补充设定" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding SupplementaryPrompt}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                                 Watermark="人设、背景、说话风格等补充设定（可选，支持多行）。例如：性格温柔但坚定，说话简洁，熟悉泰拉世界观。"/>
                        <TextBlock Text="简洁填写角色的核心人设与补充规则，将作为系统提示注入；留空则仅按基础信息对话。"
                                   FontSize="10" Foreground="{DynamicResource TextSubBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <!-- 高级折叠区（旧字段兼容） -->
                <Expander Header="补充设定（高级）" IsExpanded="{Binding IsSupplementaryExpanded}" Margin="0,8,0,0">
                    <StackPanel Margin="0,8,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="简介" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="背景设定" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Background}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="性格" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Personality}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="说话风格" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding SpeakingStyle}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="示范对话" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding DialogueExamples}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                         Watermark="用户：今天有点累。&#10;角色：那就先歇一会儿，我陪你安静坐着。"/>
                                <TextBlock Text="建议填写 6–12 组真实、多样的多轮示范；这些内容只用于模仿语气，不作为设定事实。"
                                           FontSize="10" Foreground="{DynamicResource TextSubBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="开场问候" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{DynamicResource TextSubBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding Greeting}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                        </Grid>
                    </StackPanel>
                </Expander>
                <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="取消" Command="{Binding CancelCommand}" Padding="20,8" Margin="0,0,8,0"/>
                <Button Classes="primary" Content="{Binding SubmitText}" Command="{Binding SaveCommand}" Padding="24,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

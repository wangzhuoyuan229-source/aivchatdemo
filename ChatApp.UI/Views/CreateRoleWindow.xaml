<Window x:Class="ChatApp.UI.Views.CreateRoleWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:ChatApp.UI.Converters"
        xmlns:controls="using:ChatApp.UI.Controls"
        Title="{Binding WindowTitle}" Height="780" Width="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:BooleanToVisibilityInverseConverter x:Key="Bool2VisInv"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <TextBlock Text="{Binding WindowTitle}" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <Grid Margin="0,0,0,12" RowDefinitions="Auto,Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="头像" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="8" Background="#F2F2F2"
                                ClipToBounds="True" Margin="0,0,10,0">
                            <controls:AvatarView Avatar="{Binding Avatar}" FontSize="27"/>
                        </Border>
                        <TextBox Text="{Binding Avatar}" MaxLength="8" Width="72" VerticalAlignment="Center"
                                 IsVisible="{Binding HasImageAvatar, Converter={StaticResource Bool2VisInv}}"
                                 Watermark="emoji"/>
                        <Button Classes="ghost" Content="从知识库匹配" Command="{Binding MatchAvatarCommand}"
                                IsEnabled="{Binding !IsSaving}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Classes="ghost" Content="改用 emoji" Command="{Binding UseEmojiAvatarCommand}"
                                IsVisible="{Binding HasImageAvatar, Converter={StaticResource Bool2Vis}}"
                                VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvatarMatchStatus}" FontSize="10"
                               Foreground="{StaticResource AccentDarkBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="名称 *" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Name}"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="简介" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="背景设定" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Background}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="你扮演谁" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding UserPersona}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                                 Watermark="例如：博士；或：你是罗德岛的博士，与凯尔希长期并肩工作。"/>
                        <TextBlock Text="告诉角色如何称呼你、你们是什么关系；留空时按普通用户处理。"
                                   FontSize="10" Foreground="{StaticResource TextSubBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="性格" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Personality}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="说话风格" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding SpeakingStyle}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="示范对话" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding DialogueExamples}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                 Watermark="用户：今天有点累。&#10;角色：那就先歇一会儿，我陪你安静坐着。&#10;&#10;用户：……&#10;角色：不用急着说，我在。"/>
                        <TextBlock Text="建议填写 6–12 组真实、多样的多轮示范；这些内容只用于模仿语气，不作为设定事实。"
                                   FontSize="10" Foreground="{StaticResource TextSubBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="知识分组" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <StackPanel Grid.Column="1">
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="70" MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding KnowledgeGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock Text="{Binding KnowledgeBindingHint}" FontSize="10" Foreground="#C47A00"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="开场问候" VerticalAlignment="Top" Margin="0,8" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Greeting}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
                </Grid>
                <TextBlock Text="{Binding ErrorText}" Foreground="#E53935" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="取消" Command="{Binding CancelCommand}" Padding="20,8" Margin="0,0,8,0"/>
                <Button Classes="primary" Content="{Binding SubmitText}" Command="{Binding SaveCommand}" Padding="24,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="ChatApp.UI.Views.KnowledgeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChatApp.UI.ViewModels"
             xmlns:cm="using:ChatApp.Core.Models"
             xmlns:conv="using:ChatApp.UI.Converters"
             Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:BooleanToVisibilityInverseConverter x:Key="Bool2VisInverse"/>
        <conv:NullToVisibilityConverter x:Key="Null2Vis"/>
        <conv:FilePathToBitmapConverter x:Key="ImagePath"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="知识库" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="支持多文件夹递归批量导入并保留原目录层级；图片会生成中文描述与标签并按角色分组检索。" FontSize="12" Foreground="{DynamicResource TextSubBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="↻ 刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="ghost" Content="✎ 批量管理" Command="{Binding ToggleBatchModeCommand}" Margin="0,0,8,0"/>
                    <Button Classes="ghost" Content="＋ 新建分组" Command="{Binding CreateGroupCommand}" Margin="0,0,8,0"/>
                    <Button Classes="ghost" Content="📁 批量导入文件夹" Command="{Binding ImportFolderCommand}" Margin="0,0,8,0"/>
                    <Button Classes="primary" Content="+ 导入文件/图片" Command="{Binding ImportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 导入进度条 -->
        <Border Grid.Row="1" Background="{DynamicResource WarnSoftBrush}" Padding="20,8" IsVisible="{Binding IsImporting, Converter={StaticResource Bool2Vis}}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ProgressText}" Foreground="{DynamicResource WarnBrush}" FontSize="12" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Classes="ghost" Content="取消导入" Command="{Binding CancelImportCommand}" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- 批量操作工具栏（仅批量模式显示） -->
        <Border Grid.Row="2" Background="{DynamicResource InfoSoftBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10"
                IsVisible="{Binding IsBatchMode, Converter={StaticResource Bool2Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 全选复选框 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsThreeState="True" IsChecked="{Binding IsAllSelected}" VerticalAlignment="Center"/>
                    <TextBlock Text="全选" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Classes="ghost" Content="全选" Command="{Binding SelectAllCommand}" Margin="16,0,8,0"/>
                <Button Grid.Column="2" Classes="ghost" Content="取消选择" Command="{Binding DeselectAllCommand}" Margin="0,0,8,0"/>

                <!-- 选中计数 -->
                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSubBrush}" Margin="8,0,0,0">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" 项"/>
                </TextBlock>

                <!-- 批量操作按钮 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Classes="ghost" Content="🖼 批量重新识图" Command="{Binding BatchRegenerateImagesCommand}" Margin="0,0,8,0"/>
                    <Button Classes="ghost" Content="📦 移动到分组" Command="{Binding BatchMoveCommand}" Margin="0,0,8,0"/>
                    <Button Classes="ghost" Content="🗑 批量删除" Command="{Binding BatchDeleteCommand}" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区域：左分组 + 右文档 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分组列表 -->
            <Border Grid.Column="0" Background="{DynamicResource ListPaneBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="16,12,8,8">
                        <TextBlock Text="分组 / 文件夹" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                            <Button Classes="ghost compact" Content="▸ 全部折叠" FontSize="11"
                                    Command="{Binding CollapseAllGroupsCommand}" ToolTip.Tip="折叠所有分组/文件夹"/>
                            <Button Classes="ghost compact" Content="▾ 全部展开" FontSize="11"
                                    Command="{Binding ExpandAllGroupsCommand}" ToolTip.Tip="展开所有分组/文件夹"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="GroupsList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6" IsVisible="{Binding IsVisible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="{Binding IndentWidth}"/>
                                    <Button Grid.Column="1" Content="{Binding ExpandGlyph}" FontSize="10" Width="16" Height="16" Padding="0" Margin="0,0,2,0"
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsVisible="{Binding HasChildren}"
                                            Command="{Binding DataContext.ToggleGroupExpansionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" Background="Transparent" BorderThickness="0"
                                            ToolTip.Tip="展开/折叠"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding DocumentCount}" Foreground="{DynamicResource TextSubBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <Button Grid.Column="5" Classes="ghost" Content="✎" Padding="4"
                                            IsVisible="{Binding SourceGroup, Converter={StaticResource Null2Vis}}"
                                            Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip.Tip="重命名"/>
                                    <Button Grid.Column="6" Classes="ghost" Content="×" Padding="4" Foreground="{DynamicResource DangerBrush}"
                                            IsVisible="{Binding SourceGroup, Converter={StaticResource Null2Vis}}"
                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip.Tip="删除分组"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：当前分组下的文档 -->
            <ListBox Grid.Column="1" x:Name="DocsList" ItemsSource="{Binding Documents}"
                     Background="Transparent" BorderThickness="0"
                     Padding="20,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                            <Border Classes="card" Padding="20,16" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 复选框（仅批量模式显示） -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              IsVisible="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Bool2Vis}}"/>

                                    <Grid Grid.Column="1" Width="76" Height="64" Margin="0,0,14,0">
                                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="5"
                                                IsVisible="{Binding IsImage, Converter={StaticResource Bool2Vis}}">
                                            <Image Source="{Binding PreviewPath, Converter={StaticResource ImagePath}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding ItemIcon}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsImage, Converter={StaticResource Bool2VisInverse}}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding RelativePath, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextSubBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextSubBrush}"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSubBrush}" Text="{Binding ChunkCount, StringFormat={}{0} 个片段, Mode=OneWay}"/>
                                            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextSubBrush}"/>
                                            <TextBlock Text="{Binding ImportedAt, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextSubBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxLines="2" Margin="0,6,0,0"
                                                   IsVisible="{Binding IsImage, Converter={StaticResource Bool2Vis}}"/>
                                        <TextBlock Text="{Binding Tags, StringFormat=标签：{0}}" FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                                   TextWrapping="Wrap" IsVisible="{Binding IsImage, Converter={StaticResource Bool2Vis}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                                    IsVisible="{Binding IsImage, Converter={StaticResource Bool2Vis}}">
                                            <TextBlock Text="{Binding DescriptionSourceText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource TextSubBrush}"/>
                                            <TextBlock Text="{Binding ProviderModelText}" FontSize="11" Foreground="{DynamicResource TextSubBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

<StackPanel Grid.Column="3" Orientation="Horizontal"
                                                IsVisible="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Bool2VisInverse}}">
                                        <Button Classes="ghost" Content="查看原图"
                                                IsVisible="{Binding IsImage, Converter={StaticResource Bool2Vis}}"
                                                Command="{Binding DataContext.OpenImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="ghost" Content="编辑描述"
                                                IsVisible="{Binding IsImage, Converter={StaticResource Bool2Vis}}"
                                                Command="{Binding DataContext.EditImageMetadataCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="ghost" Content="重新识图"
                                                IsVisible="{Binding IsImage, Converter={StaticResource Bool2Vis}}"
                                                Command="{Binding DataContext.RegenerateImageDescriptionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="ghost" Content="移动"
                                                Command="{Binding DataContext.MoveDocumentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Classes="ghost" Content="删除" Foreground="{DynamicResource DangerBrush}"
                                            IsVisible="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Bool2VisInverse}}"
                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
        </Grid>
    </Grid>
</UserControl>

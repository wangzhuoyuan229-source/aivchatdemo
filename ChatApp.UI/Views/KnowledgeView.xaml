<UserControl x:Class="ChatApp.UI.Views.KnowledgeView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChatApp.UI.ViewModels"
             xmlns:cm="using:ChatApp.Core.Models"
             xmlns:conv="using:ChatApp.UI.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:BooleanToVisibilityInverseConverter x:Key="Bool2VisInverse"/>
        <conv:NullToVisibilityConverter x:Key="Null2Vis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="📚 知识库" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="导入小说/设定集等文档，AI 将基于其世界观回答。左侧可创建分组管理文档。" FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="↻ 刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="ghost" Content="✎ 批量管理" Command="{Binding ToggleBatchModeCommand}" Margin="0,0,8,0"/>
                    <Button Classes="ghost" Content="＋ 新建分组" Command="{Binding CreateGroupCommand}" Margin="0,0,8,0"/>
                    <Button Classes="ghost" Content="📁 导入文件夹" Command="{Binding ImportFolderCommand}" Margin="0,0,8,0"/>
                    <Button Classes="primary" Content="+ 导入文档" Command="{Binding ImportCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 导入进度条 -->
        <Border Grid.Row="1" Background="#FFFBEA" Padding="20,8" IsVisible="{Binding IsImporting, Converter={StaticResource Bool2Vis}}">
            <TextBlock Text="{Binding ProgressText}" Foreground="#B8860B" FontSize="12"/>
        </Border>

        <!-- 批量操作工具栏（仅批量模式显示） -->
        <Border Grid.Row="2" Background="#F0F7FF" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10"
                IsVisible="{Binding IsBatchMode, Converter={StaticResource Bool2Vis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 全选复选框 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsThreeState="True" IsChecked="{Binding IsAllSelected}" VerticalAlignment="Center"/>
                    <TextBlock Text="全选" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Classes="ghost" Content="全选" Command="{Binding SelectAllCommand}" Margin="16,0,8,0"/>
                <Button Grid.Column="2" Classes="ghost" Content="取消选择" Command="{Binding DeselectAllCommand}" Margin="0,0,8,0"/>

                <!-- 选中计数 -->
                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSubBrush}" Margin="8,0,0,0">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" 项"/>
                </TextBlock>

                <!-- 批量操作按钮 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Classes="ghost" Content="📦 移动到分组" Command="{Binding BatchMoveCommand}" Margin="0,0,8,0"/>
                    <Button Classes="ghost" Content="🗑 批量删除" Command="{Binding BatchDeleteCommand}" Foreground="#E53935"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区域：左分组 + 右文档 -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分组列表 -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="分组" FontWeight="SemiBold" FontSize="13" Margin="16,12,0,8"/>
                    <ListBox x:Name="GroupsList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🗂" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DocumentCount}" Foreground="{StaticResource TextSubBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    <Button Grid.Column="3" Classes="ghost" Content="✎" Padding="4"
                                            IsVisible="{Binding SourceGroup, Converter={StaticResource Null2Vis}}"
                                            Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip.Tip="重命名"/>
                                    <Button Grid.Column="4" Classes="ghost" Content="×" Padding="4" Foreground="#E53935"
                                            IsVisible="{Binding SourceGroup, Converter={StaticResource Null2Vis}}"
                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip.Tip="删除分组"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：当前分组下的文档 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20,8">
                <ItemsControl x:Name="DocsList" ItemsSource="{Binding Documents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="6" Padding="16,12" Margin="0,0,0,10"
                                    BoxShadow="0 1 6 0 #26000000">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 复选框（仅批量模式显示） -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              IsVisible="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bool2Vis}}"/>

                                    <TextBlock Grid.Column="1" Text="📄" FontSize="28" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding FileName, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSubBrush}"/>
                                            <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextSubBrush}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSubBrush}" Text="{Binding ChunkCount, StringFormat={}{0} 个片段, Mode=OneWay}"/>
                                            <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextSubBrush}"/>
                                            <TextBlock Text="{Binding ImportedAt, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}" FontSize="11" Foreground="{StaticResource TextSubBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="3" Classes="ghost" Content="移动"
                                            IsVisible="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bool2VisInverse}}"
                                            Command="{Binding DataContext.MoveDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="4" Classes="ghost" Content="删除" Foreground="#E53935"
                                            IsVisible="{Binding DataContext.IsBatchMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Bool2VisInverse}}"
                                            Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

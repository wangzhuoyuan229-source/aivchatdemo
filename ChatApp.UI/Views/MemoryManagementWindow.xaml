<Window x:Class="ChatApp.UI.Views.MemoryManagementWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChatApp.UI.ViewModels"
        Title="记忆管理" Width="560" Height="600"
        WindowStartupLocation="CenterOwner" MinWidth="420" MinHeight="380"
        Background="{DynamicResource BgBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Row="0" Text="{Binding HeaderText}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,8"/>
            <ComboBox Grid.Row="1" ItemsSource="{Binding SelectableRoles}" SelectedItem="{Binding SelectedRole}"
                      Margin="0,0,0,8" MinWidth="220" HorizontalAlignment="Left"
                      IsVisible="{Binding HasSelectableRoles}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
                       Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap"/>
        </Grid>

        <Border Grid.Row="1" Classes="card" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Items}" Background="Transparent" BorderThickness="0" Padding="6">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="2,4" Padding="10" CornerRadius="6"
                                Background="{DynamicResource SubtlePanelBrush}">
                            <Grid RowDefinitions="Auto,Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding CreatedText}" FontSize="10"
                                               Foreground="{DynamicResource TimeBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Classes="ghost" Content="编辑" Padding="8,2" Margin="4,0,0,0"
                                            Command="{Binding $parent[ListBox].DataContext.EditCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="2" Classes="ghost" Content="删除" Padding="8,2" Margin="4,0,0,0"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Command="{Binding $parent[ListBox].DataContext.DeleteCommand}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Content}" FontSize="13" TextWrapping="Wrap"
                                           Margin="0,6,0,0" Foreground="{DynamicResource TextMainBrush}"
                                           IsVisible="{Binding !IsEditing}"/>
                                <StackPanel Grid.Row="2" Margin="0,6,0,0" IsVisible="{Binding IsEditing}">
                                    <TextBox Text="{Binding Draft}" TextWrapping="Wrap" MinHeight="64"
                                             AcceptsReturn="True" FontSize="13"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Classes="primary" Content="保存" Padding="14,4"
                                                Command="{Binding $parent[ListBox].DataContext.SaveEditCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Classes="ghost" Content="取消" Padding="14,4" Margin="6,0,0,0"
                                                Command="{Binding $parent[ListBox].DataContext.CancelEditCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,16,0,0">
            <TextBox Grid.Column="0" Text="{Binding NewMemoryText}" Watermark="手动新增一条记忆…"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Classes="primary" Content="新增" Margin="8,0,0,0"
                    Command="{Binding AddCommand}"/>
            <Button Grid.Column="2" Classes="ghost" Content="清空全部" Margin="6,0,0,0"
                    Foreground="{DynamicResource DangerBrush}"
                    Command="{Binding ClearCommand}"/>
        </Grid>
    </Grid>
</Window>

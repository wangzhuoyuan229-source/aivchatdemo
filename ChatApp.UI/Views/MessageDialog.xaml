<Window x:Class="ChatApp.UI.Views.MessageDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MinHeight="170" MaxHeight="520"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
  <Grid Margin="22" RowDefinitions="*,20,Auto">
    <ScrollViewer MaxHeight="360">
      <TextBlock Text="{Binding MessageText}" TextWrapping="Wrap" LineHeight="22"/>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelButton" Classes="ghost" Content="{Binding CancelText}" Click="Cancel_Click"/>
      <Button x:Name="SecondaryButton" Classes="ghost" Content="{Binding SecondaryText}" Click="Secondary_Click"/>
      <Button Classes="primary" Content="{Binding PrimaryText}" Click="Primary_Click"/>
    </StackPanel>
  </Grid>
</Window>

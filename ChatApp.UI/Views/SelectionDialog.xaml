<Window x:Class="ChatApp.UI.Views.SelectionDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择" Width="380" Height="200"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding PromptText}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMainBrush}"/>
        <ComboBox Grid.Row="2" x:Name="SelectionBox" ItemsSource="{Binding Options}"
                  Padding="6,4" FontSize="14">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Classes="ghost" Content="取消" Margin="0,0,8,0" Padding="20,6" Click="Cancel_Click"/>
            <Button Classes="primary" Content="确定" Padding="20,6" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>

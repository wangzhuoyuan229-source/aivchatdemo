<Window x:Class="ChatApp.UI.Views.SelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择" Width="380" Height="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding PromptText}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMainBrush}"/>
        <ComboBox Grid.Row="2" x:Name="SelectionBox"
                  ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                  Padding="6,4" FontSize="14"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource GhostButton}" Content="取消" Margin="0,0,8,0" Padding="20,6" IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="确定" Padding="20,6" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>

                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="图片最低相似度" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="图片和对话内容的匹配门槛。&#10;原理同‘知识最低相似度’，调高则只有非常相关的图才会被选中。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="图片和对话内容的匹配门槛。&#10;原理同‘知识最低相似度’，调高则只有非常相关的图才会被选中。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <TextBox Text="{Binding KnowledgeImageMinScore}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,0" Width="220" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="对话温度（0–2，默认 0.65）" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                            <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="AI 的‘想象力’旋钮。&#10;0 = 最守规矩，只按设定说话；2 = 最放飞，创意多但容易胡说。&#10;角色扮演建议 0.6~0.85，默认 0.65。&#10;想更稳重调低，想更活泼调高。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="AI 的‘想象力’旋钮。&#10;0 = 最守规矩，只按设定说话；2 = 最放飞，创意多但容易胡说。&#10;角色扮演建议 0.6~0.85，默认 0.65。&#10;想更稳重调低，想更活泼调高。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBox Text="{Binding ChatTemperature}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="严格模式：未命中角色绑定资料时，涉及客观设定的问题会要求角色承认无法确认。"
                               FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- P2 toggles -->
            <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="扩展功能（P2）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <CheckBox Content="启用语音交互" IsChecked="{Binding EnableVoice}" VerticalAlignment="Center"/>
                        <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="打开后，以后可以让角色用语音和你对话（需后续支持）。&#10;现在只是开关，不影响文字聊天，小白可先关闭。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="打开后，以后可以让角色用语音和你对话（需后续支持）。&#10;现在只是开关，不影响文字聊天，小白可先关闭。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                        <CheckBox Content="启用角色好感度系统" IsChecked="{Binding EnableAffinity}" VerticalAlignment="Center"/>
                        <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="打开后，角色会根据你的话产生好感度变化（越聊越喜欢你）。&#10;适合想玩养成、攻略的玩法；不想被数值打扰就关闭。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="打开后，角色会根据你的话产生好感度变化（越聊越喜欢你）。&#10;适合想玩养成、攻略的玩法；不想被数值打扰就关闭。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Group chat -->
            <Border Grid.Row="5" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="群聊设置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="发言模式" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="群聊时谁决定下一个说话的人：&#10;• 轮询制：所有人按顺序一个个来（最公平）&#10;• 混合式：AI 导演挑几个人说（最智能，推荐）&#10;• 自由插话：谁想说谁说（更热闹但更乱，暂未开放）" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="群聊时谁决定下一个说话的人：&#10;• 轮询制：所有人按顺序一个个来（最公平）&#10;• 混合式：AI 导演挑几个人说（最智能，推荐）&#10;• 自由插话：谁想说谁说（更热闹但更乱，暂未开放）" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding GroupChatModeOptions}" SelectedItem="{Binding GroupChatMode}"
                                      Margin="0,4,0,0" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="每轮发言人数（Hybrid）" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="只有‘混合式’下才有用：每轮让几个人发言。&#10;比如填 2，就是每轮挑 2 个角色回你。&#10;人多时填 2~3 更热闹，人少填 1。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="只有‘混合式’下才有用：每轮让几个人发言。&#10;比如填 2，就是每轮挑 2 个角色回你。&#10;人多时填 2~3 更热闹，人少填 1。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <TextBox Text="{Binding MaxSpeakersPerTurn}" Width="80" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <CheckBox Content="允许角色之间互相回应/反驳" IsChecked="{Binding RespondToOtherAgents}" VerticalAlignment="Center"/>
                        <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="打开后，群聊里角色们会互相接话、吵架、打圆场。&#10;关闭则它们只会各自回你，不会理别的角色。&#10;想看角色间互动就打开。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="打开后，群聊里角色们会互相接话、吵架、打圆场。&#10;关闭则它们只会各自回你，不会理别的角色。&#10;想看角色间互动就打开。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </StackPanel>
                    <TextBlock Text="轮询制：每轮所有成员依次发言；混合式：导演选择指定人数发言；自由插话（Phase 2）。"
                               FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>

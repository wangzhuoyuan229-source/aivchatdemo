<UserControl x:Class="ChatApp.UI.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:ChatApp.UI.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <Grid MaxWidth="720" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="⚙️ 设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- AI service -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="远程 AI 服务（BYOK · 自动保存）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               IsVisible="{Binding StatusText, Converter={StaticResource StringToVis}}"/>

                    <TextBlock Text="远程 API Base URL（仅 HTTPS）" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <ComboBox ItemsSource="{Binding PresetEndpoints}" Text="{Binding ApiBaseUrl}"
                              IsEditable="True" Margin="0,4,0,12"/>

                    <TextBlock Text="API Key" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Text="{Binding ApiKey}" PasswordChar="●" Margin="0,4,0,4"/>
                    <TextBlock Text="{Binding ProviderHint}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,12" TextWrapping="Wrap" IsVisible="{Binding ProviderHint, Converter={StaticResource StringToVis}}"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="聊天模型" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <ComboBox ItemsSource="{Binding CommonChatModels}" Text="{Binding ChatModel}"
                                      IsEditable="True" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Embedding 模型" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <ComboBox ItemsSource="{Binding CommonEmbeddingModels}" Text="{Binding EmbeddingModel}"
                                      IsEditable="True" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Embedding 服务预设" FontSize="12"
                               Foreground="{StaticResource TextSubBrush}" Margin="0,12,0,0"/>
                    <ComboBox ItemsSource="{Binding EmbeddingProviderPresets}"
                              SelectedItem="{Binding EmbeddingProviderPreset}"
                              Margin="0,4,0,0"/>
                    <TextBlock Text="选择“阿里云百炼”会自动使用 text-embedding-v4；请在下方填写百炼 API Key。"
                               FontSize="11" Foreground="{StaticResource TextSubBrush}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="独立 Embedding API Base URL（可选）" FontSize="12"
                               Foreground="{StaticResource TextSubBrush}" Margin="0,12,0,0"/>
                    <ComboBox ItemsSource="{Binding PresetEndpoints}" Text="{Binding EmbeddingApiBaseUrl}"
                              IsEditable="True" Margin="0,4,0,8"/>
                    <TextBlock Text="独立 Embedding API Key（可选）" FontSize="12"
                               Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Text="{Binding EmbeddingApiKey}" PasswordChar="●" Margin="0,4,0,0"/>
                    <TextBlock Text="留空时沿用上方聊天端点和 Key；DeepSeek 不提供 Embedding 时，请填写其他远程服务。"
                               FontSize="11" Foreground="{StaticResource TextSubBrush}"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="默认推荐 DeepSeek V4 Flash。仅允许远程 HTTPS、OpenAI 兼容 API；localhost、私有地址和本地模型会被拒绝。"
                               FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- RAG / memory -->
            <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="记忆与知识库" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <CheckBox Content="启用长期记忆（RAG 召回历史）" IsChecked="{Binding EnableLongTermMemory}" Margin="0,4"/>
                    <CheckBox Content="启用知识库检索" IsChecked="{Binding EnableKnowledgeBase}" Margin="0,4"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="上下文窗口" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding ContextWindowSize}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="记忆召回 Top-K" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding MemoryTopK}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="知识召回 Top-K" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding KnowledgeTopK}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="记忆批量大小（每多少条消息触发一次向量化）" FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding MemoryBatchSize}" Width="120" HorizontalAlignment="Left"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="知识最低相似度" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding KnowledgeMinScore}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="知识上下文字数" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding KnowledgeContextCharBudget}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="相邻分块半径" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding KnowledgeNeighborRadius}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,12,0,0" Width="220" HorizontalAlignment="Left">
                        <TextBlock Text="对话温度（0–2，默认 0.65）" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                        <TextBox Text="{Binding ChatTemperature}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock Text="严格模式：未命中角色绑定资料时，涉及客观设定的问题会要求角色承认无法确认。"
                               FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- P2 toggles -->
            <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="扩展功能（P2）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox Content="启用语音交互" IsChecked="{Binding EnableVoice}" Margin="0,4"/>
                    <CheckBox Content="启用角色好感度系统" IsChecked="{Binding EnableAffinity}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <!-- Group chat -->
            <Border Grid.Row="4" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="群聊设置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="发言模式" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <ComboBox ItemsSource="{Binding GroupChatModeOptions}" SelectedItem="{Binding GroupChatMode}"
                                      Margin="0,4,0,0" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="每轮发言人数（Hybrid）" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding MaxSpeakersPerTurn}" Width="80" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="允许角色之间互相回应/反驳" IsChecked="{Binding RespondToOtherAgents}" Margin="0,4"/>
                    <TextBlock Text="轮询制：每轮所有成员依次发言；混合式：导演选择指定人数发言；自由插话（Phase 2）。"
                               FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>

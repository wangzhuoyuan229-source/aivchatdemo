<UserControl x:Class="ChatApp.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ChatApp.UI.Converters"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <Grid MaxWidth="720" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="⚙️ 设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- AI service -->
            <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AI 服务（BYOK）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <TextBlock Text="API Base URL" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <ComboBox ItemsSource="{Binding PresetEndpoints}" Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" Margin="0,4,0,12"/>

                    <TextBlock Text="API Key" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                    <TextBlock Text="{Binding ProviderHint}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                               Margin="0,0,0,12" TextWrapping="Wrap" Visibility="{Binding ProviderHint, Converter={StaticResource StringToVis}}"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="聊天模型" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <ComboBox ItemsSource="{Binding CommonChatModels}" Text="{Binding ChatModel, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Embedding 模型" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <ComboBox ItemsSource="{Binding CommonEmbeddingModels}" Text="{Binding EmbeddingModel, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="提示：兼容 OpenAI 协议的端点均可使用，如 DeepSeek、通义千问、SiliconFlow、本地 Ollama 等。"
                               FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- RAG / memory -->
            <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="记忆与知识库" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <CheckBox Content="启用长期记忆（RAG 召回历史）" IsChecked="{Binding EnableLongTermMemory}" Margin="0,4"/>
                    <CheckBox Content="启用知识库检索" IsChecked="{Binding EnableKnowledgeBase}" Margin="0,4"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="上下文窗口" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding ContextWindowSize}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="记忆召回 Top-K" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding MemoryTopK}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="知识召回 Top-K" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding KnowledgeTopK}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="记忆批量大小（每多少条消息触发一次向量化）" FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding MemoryBatchSize}" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- P2 toggles -->
            <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="扩展功能（P2）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <CheckBox Content="启用语音交互" IsChecked="{Binding EnableVoice}" Margin="0,4"/>
                    <CheckBox Content="启用角色好感度系统" IsChecked="{Binding EnableAffinity}" Margin="0,4"/>
                </StackPanel>
            </Border>

            <!-- Group chat -->
            <Border Grid.Row="4" Background="White" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="群聊设置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="发言模式" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <ComboBox ItemsSource="{Binding GroupChatModeOptions}" SelectedItem="{Binding GroupChatMode}"
                                      Margin="0,4,0,0" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <TextBlock Text="每轮最多发言人数（Hybrid）" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
                            <TextBox Text="{Binding MaxSpeakersPerTurn}" Width="80" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="允许角色之间互相回应/反驳" IsChecked="{Binding RespondToOtherAgents}" Margin="0,4"/>
                    <TextBlock Text="轮询制：按顺序每人发言一轮；混合式：导演选 1-N 人发言；自由插话（Phase 2）。"
                               FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Save -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource PrimaryButton}" Content="保存设置" Command="{Binding SaveCommand}" Padding="24,10"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

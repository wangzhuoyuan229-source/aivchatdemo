<UserControl x:Class="ChatApp.UI.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:ChatApp.UI.Converters"
             Background="{DynamicResource BgBrush}">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
        <Grid MaxWidth="720" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="⚙️ 设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- AI service -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="远程 AI 服务（BYOK · 自动保存）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,10" TextWrapping="Wrap"
                               IsVisible="{Binding StatusText, Converter={StaticResource StringToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="6">
                        <CheckBox IsChecked="{Binding UseUnifiedApi}" VerticalAlignment="Center">
                            <TextBlock Text="统一 API 模式：聊天、Embedding、多模态识图共用下方同一端点和 API Key（推荐 SiliconFlow 等聚合平台）"
                                       TextWrapping="Wrap"/>
                        </CheckBox>
                        <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="小白理解：打开后，聊天、记知识、看图都用同一把钥匙和同一个地址，一次填好就行。&#10;适合你只买了一家聚合平台（如 SiliconFlow、阿里百炼）的情况。&#10;如果你的聊天用 DeepSeek，但记知识用阿里百炼、看图用别的，就要关掉，分开填。&#10;例子：只买 SiliconFlow→打开；聊天 DeepSeek + 记知识 阿里百炼→关闭。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="小白理解：打开后，聊天、记知识、看图都用同一把钥匙和同一个地址，一次填好就行。&#10;适合你只买了一家聚合平台（如 SiliconFlow、阿里百炼）的情况。&#10;如果你的聊天用 DeepSeek，但记知识用阿里百炼、看图用别的，就要关掉，分开填。&#10;例子：只买 SiliconFlow→打开；聊天 DeepSeek + 记知识 阿里百炼→关闭。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding UseUnifiedApi}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
                            <TextBlock Text="统一 API 预设" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                            <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="统一模式下无需单独选模型，选一个预设即可一键填好对话/向量/视觉三模型。&#10;• SiliconFlow（推荐）：deepseek-ai/DeepSeek-V3.1 + BAAI/bge-m3 + Qwen3-VL&#10;• 阿里云百炼：qwen-plus + text-embedding-v4 + qwen3-vl-flash&#10;• OpenAI：gpt-4o-mini + text-embedding-3-small&#10;选自定义可单独手填模型。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="统一模式下无需单独选模型，选一个预设即可一键填好对话/向量/视觉三模型。&#10;• SiliconFlow（推荐）：deepseek-ai/DeepSeek-V3.1 + BAAI/bge-m3 + Qwen3-VL&#10;• 阿里云百炼：qwen-plus + text-embedding-v4 + qwen3-vl-flash&#10;• OpenAI：gpt-4o-mini + text-embedding-3-small&#10;选自定义可单独手填模型。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding UnifiedPresetOptions}" SelectedItem="{Binding UnifiedPresetName}" Margin="0,4,0,0"/>
                        <TextBlock Text="统一模式下对话/向量/视觉模型由预设自动填充，无需单独选择；自定义预设除外。" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
                        <TextBlock Text="远程 API Base URL（仅 HTTPS）" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                        <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="就是 AI 公司的服务器网址。&#10;小白不用手打，直接在下拉框选：DeepSeek / OpenAI / SiliconFlow / 阿里百炼。&#10;只支持 https 开头的远程地址，不能填本地或 http。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="就是 AI 公司的服务器网址。&#10;小白不用手打，直接在下拉框选：DeepSeek / OpenAI / SiliconFlow / 阿里百炼。&#10;只支持 https 开头的远程地址，不能填本地或 http。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding PresetEndpoints}" Text="{Binding ApiBaseUrl}"
                              IsEditable="True" Margin="0,4,0,12"/>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
                        <TextBlock Text="API Key" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                        <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="相当于你在 AI 平台的密码。&#10;去官网注册后会给你一串 sk- 开头的字符，复制粘贴到这里。&#10;只保存在你自己电脑上，不会上传，也不会显示给别人。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="相当于你在 AI 平台的密码。&#10;去官网注册后会给你一串 sk- 开头的字符，复制粘贴到这里。&#10;只保存在你自己电脑上，不会上传，也不会显示给别人。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                    </StackPanel>
                    <TextBox Text="{Binding ApiKey}" PasswordChar="●" Margin="0,4,0,4"/>
                    <TextBlock Text="{Binding ProviderHint}" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                               Margin="0,0,0,12" TextWrapping="Wrap" IsVisible="{Binding ProviderHint, Converter={StaticResource StringToVis}}"/>

                    <Grid Margin="0,0,0,0" IsEnabled="{Binding AreIndividualModelsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="聊天模型" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="决定陪你聊天的 AI 有多聪明。&#10;不确定就用推荐的 deepseek-v4-flash（又快又便宜）。&#10;也可以下拉选 gpt-4o-mini、qwen-plus 等，选了就能直接用。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="决定陪你聊天的 AI 有多聪明。&#10;不确定就用推荐的 deepseek-v4-flash（又快又便宜）。&#10;也可以下拉选 gpt-4o-mini、qwen-plus 等，选了就能直接用。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding CommonChatModels}" Text="{Binding ChatModel}"
                                      IsEditable="True" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="Embedding 模型" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="帮 AI‘记知识’的专用模型，把你的文档变成它能搜索的记忆。&#10;小白不用单独纠结这个名字，跟着下面的‘Embedding 服务预设’选就行，它会自动填好。&#10;例如选‘阿里云百炼’会自动填 text-embedding-v4。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="帮 AI‘记知识’的专用模型，把你的文档变成它能搜索的记忆。&#10;小白不用单独纠结这个名字，跟着下面的‘Embedding 服务预设’选就行，它会自动填好。&#10;例如选‘阿里云百炼’会自动填 text-embedding-v4。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding CommonEmbeddingModels}" Text="{Binding EmbeddingModel}"
                                      IsEditable="True" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="统一 API 模式下，Embedding 和多模态请求会自动复用上方端点和 Key，只需分别为各功能填写模型 ID；DeepSeek 官方端点不提供 Embedding 与视觉能力。"
                               FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                               Margin="0,12,0,0" TextWrapping="Wrap"
                               IsVisible="{Binding UseUnifiedApi}"/>
                    <StackPanel IsVisible="{Binding !UseUnifiedApi}">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
                            <TextBlock Text="Embedding 服务预设" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                            <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="一键帮你填好‘记知识’那一套。&#10;小白直接选：&#10;• 阿里云百炼（推荐，国内快）&#10;• SiliconFlow&#10;• OpenAI&#10;选完会自动填地址和模型，你只需再填对应的密码。&#10;选‘未配置’就是暂时不用知识库记忆。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="一键帮你填好‘记知识’那一套。&#10;小白直接选：&#10;• 阿里云百炼（推荐，国内快）&#10;• SiliconFlow&#10;• OpenAI&#10;选完会自动填地址和模型，你只需再填对应的密码。&#10;选‘未配置’就是暂时不用知识库记忆。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding EmbeddingProviderPresets}"
                                  SelectedItem="{Binding EmbeddingProviderPreset}"
                                  Margin="0,4,0,0"/>
                        <TextBlock Text="选择“阿里云百炼”会自动使用 text-embedding-v4；请在下方填写百炼 API Key。"
                                   FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
                            <TextBlock Text="独立 Embedding API Base URL（可选）" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                            <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="专门用来‘记知识’的服务器地址。&#10;如果打开了‘统一模式’，这里可留空，会自动用上面的主地址。&#10;只有当聊天和记知识是两家不同公司时才需要单独填，比如聊天用 DeepSeek（它不提供记知识），就要在这里填百炼或 SiliconFlow 的地址。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="专门用来‘记知识’的服务器地址。&#10;如果打开了‘统一模式’，这里可留空，会自动用上面的主地址。&#10;只有当聊天和记知识是两家不同公司时才需要单独填，比如聊天用 DeepSeek（它不提供记知识），就要在这里填百炼或 SiliconFlow 的地址。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding PresetEndpoints}" Text="{Binding EmbeddingApiBaseUrl}"
                                  IsEditable="True" Margin="0,4,0,8"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="独立 Embedding API Key（可选）" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                            <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="专门用来‘记知识’的密码。&#10;统一模式下可留空，共用主密码；分开买的服务就各自填各自的密码。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="专门用来‘记知识’的密码。&#10;统一模式下可留空，共用主密码；分开买的服务就各自填各自的密码。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBox Text="{Binding EmbeddingApiKey}" PasswordChar="●" Margin="0,4,0,0"/>
                        <TextBlock Text="留空时沿用上方聊天端点和 Key；DeepSeek 不提供 Embedding 时，请填写其他远程服务。"
                                   FontSize="11" Foreground="{DynamicResource TextSubBrush}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="默认推荐 DeepSeek V4 Flash。仅允许远程 HTTPS、OpenAI 兼容 API；localhost、私有地址和本地模型会被拒绝。"
                               FontSize="11" Foreground="{DynamicResource TextSubBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Spacing="10">
                        <Button Content="测试聊天连接" Command="{Binding TestChatConnectionCommand}"
                                IsEnabled="{Binding !IsTestingChat}"/>
                        <Button Content="测试 Embedding 连接" Command="{Binding TestEmbeddingConnectionCommand}"
                                IsEnabled="{Binding !IsTestingEmbedding}"/>
                        <TextBlock Text="{Binding ChatTestStatus}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock Text="{Binding EmbeddingTestStatus}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Independent multimodal service -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="独立多模态图片识别 API" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="仅在导入或重新识图时调用，不会替换聊天模型，也不会在正常回复时重复读取图片。"
                               FontSize="11" Foreground="{DynamicResource TextSubBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="统一 API 模式下，多模态请求直接使用上方主 API 端点和 Key，此处只需填写视觉模型；切换回三路独立模式后，下方端点和密钥会自动恢复。"
                               FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                               IsVisible="{Binding UseUnifiedApi}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" IsVisible="{Binding !UseUnifiedApi}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="服务预设" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="一键填好‘看图’的地址和模型。&#10;小白选：&#10;• 阿里云百炼（推荐，识图准）&#10;• 智谱、火山方舟、SiliconFlow&#10;切换时不会清空你已填的密码。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="一键填好‘看图’的地址和模型。&#10;小白选：&#10;• 阿里云百炼（推荐，识图准）&#10;• 智谱、火山方舟、SiliconFlow&#10;切换时不会清空你已填的密码。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding VisionProviderPresetOptions}"
                                      SelectedItem="{Binding VisionProviderPresetName}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="协议" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                                <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="和‘看图’服务打交道的方式。&#10;一般选 ChatCompletions 就行（兼容 OpenAI）；如果平台文档说用 Responses 再切换。&#10;小白跟着预设自动选的走，无需手动改。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="和‘看图’服务打交道的方式。&#10;一般选 ChatCompletions 就行（兼容 OpenAI）；如果平台文档说用 Responses 再切换。&#10;小白跟着预设自动选的走，无需手动改。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding VisionProtocolOptions}"
                                      SelectedItem="{Binding VisionProtocol}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel IsVisible="{Binding !UseUnifiedApi}">
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
                            <TextBlock Text="多模态 API Base URL（仅 HTTPS）" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
                            <Button Width="16" Height="16" CornerRadius="8" Padding="0" Background="{DynamicResource SubtleBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="‘看图’服务的服务器地址。&#10;统一模式下可留空；独立模式下，去识图平台官网复制 https 地址粘过来。" ToolTip.Placement="Right" ToolTip.ShowDelay="0">
                                <TextBlock Text="?" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSubBrush}"/>
                                <Button.Flyout>
                                    <Flyout Placement="Right">
                                        <TextBlock Text="‘看图’服务的服务器地址。&#10;统一模式下可留空；独立模式下，去识图平台官网复制 https 地址粘过来。" TextWrapping="Wrap" MaxWidth="320" FontSize="12"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                        <TextBox Text="{Binding VisionApiBaseUrl}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,12,0,0">
                            <TextBlock Text="多模态 API Key" FontSize="12" Foreground="{DynamicResource TextSubBrush}" VerticalAlignment="Center"/>
